{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["{HOOKS_DIR}/arm_gate.py"],
            "timeout": 30,
            "statusMessage": "arm commit gate"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "{HOOKS_DIR}/guard_paths.py"
            ],
            "timeout": 15,
            "statusMessage": "path guard"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "{HOOKS_DIR}/guard_bash.py"
            ],
            "timeout": 15,
            "statusMessage": "bash guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "{HOOKS_DIR}/format_py.py"
            ],
            "timeout": 30,
            "statusMessage": "ruff format"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "{HOOKS_DIR}/remind_evaluator.py"
            ],
            "timeout": 20,
            "statusMessage": "evaluator reminder"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "{HOOKS_DIR}/inject_plan_pointer.py"
            ],
            "timeout": 15,
            "statusMessage": "plan pointer"
          }
        ]
      }
    ]
  }
}
